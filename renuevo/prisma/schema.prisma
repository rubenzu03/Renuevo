generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Subscription {
  id                  String       @id @default(cuid())
  name                String
  priceCurrent        Decimal      @map("price_current")
  currency            String
  billingCycle        BillingCycle @map("billing_cycle")
  billingIntervalDays Int?         @map("billing_interval_days")
  nextRenewalDate     DateTime     @map("next_renewal_date")
  category            String?
  isActive            Boolean      @default(true) @map("is_active")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  priceHistories   PriceHistory[]
  notificationLogs NotificationLog[]
}

model PriceHistory {
  id             String       @id @default(cuid())
  price          Decimal
  recordedAt     DateTime     @default(now()) @map("recorded_at")
  subscriptionId String       @map("subscription_id")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  notificationLog NotificationLog?
}

model NotificationLog {
  id                String        @id @default(cuid())
  subscriptionId    String        @map("subscription_id")
  type              String
  billingCycleStart DateTime?     @map("billing_cycle_start")
  priceHistoryId    String?       @unique @map("price_history_id")
  priceHistory      PriceHistory? @relation(fields: [priceHistoryId], references: [id], onDelete: Cascade)
  sentAt            DateTime      @default(now()) @map("sent_at")
  subscription      Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, type, billingCycleStart])
}

model BankConnection {
  id              String           @id @default(cuid())
  provider        BankProvider     @default(mock)
  institutionName String           @map("institution_name")
  status          ConnectionStatus @default(connected)
  syncedAt        DateTime?        @map("synced_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  transactions BankTransaction[]
  suggested    SuggestedSubscription[]

  @@map("bank_connection")
}

model BankTransaction {
  id           String         @id @default(cuid())
  connectionId String         @map("connection_id")
  connection   BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalId   String         @map("external_id")
  merchantName String         @map("merchant_name")
  amount       Decimal
  currency     String
  date         DateTime
  createdAt    DateTime       @default(now()) @map("created_at")

  @@unique([connectionId, externalId])
  @@index([connectionId, date])
  @@map("bank_transaction")
}

model SuggestedSubscription {
  id           String           @id @default(cuid())
  connectionId String           @map("connection_id")
  connection   BankConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  merchantName String           @map("merchant_name")
  amount       Decimal
  currency     String
  billingCycle BillingCycle     @map("billing_cycle")
  occurrences  Int
  firstSeen    DateTime         @map("first_seen")
  nextDueDate  DateTime         @map("next_due_date")
  priceChanged Boolean          @default(false) @map("price_changed")
  status       SuggestionStatus @default(pending)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@unique([connectionId, merchantName])
  @@index([connectionId, status])
  @@map("suggested_subscription")
}

enum BillingCycle {
  weekly
  monthly
  quarterly
  yearly
}

enum BankProvider {
  mock
  plaid
}

enum ConnectionStatus {
  connected
  error
}

enum SuggestionStatus {
  pending
  accepted
  dismissed
}
