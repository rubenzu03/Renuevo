generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Subscription {
  id                  String       @id @default(cuid())
  name                String
  priceCurrent        Decimal      @map("price_current")
  currency            String
  billingCycle        BillingCycle @map("billing_cycle")
  billingIntervalDays Int?         @map("billing_interval_days")
  nextRenewalDate     DateTime     @map("next_renewal_date")
  category            String?
  isActive            Boolean      @default(true) @map("is_active")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  priceHistories   PriceHistory[]
  notificationLogs NotificationLog[]
}

model PriceHistory {
  id             String       @id @default(cuid())
  price          Decimal
  recordedAt     DateTime     @default(now()) @map("recorded_at")
  subscriptionId String       @map("subscription_id")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id                String       @id @default(cuid())
  subscriptionId    String       @map("subscription_id")
  type              String
  billingCycleStart DateTime     @map("billing_cycle_start")
  sentAt            DateTime     @default(now()) @map("sent_at")
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, type, billingCycleStart])
}

enum BillingCycle {
  weekly
  monthly
  quarterly
  yearly
}
