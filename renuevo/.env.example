DATABASE_URL=postgres://renuevo:renuevo@localhost:5432/renuevo
POSTGRES_USER=renuevo
POSTGRES_PASSWORD=renuevo
POSTGRES_DB=renuevo

APP_PASSWORD=change-me
AUTH_SECRET=change-me-to-a-long-random-string

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=Renuevo <no-reply@renuevo.local>
NOTIFY_EMAIL=no-reply@renuevo.local
CRON_SECRET=change-me
CRON_SCHEDULE=0 6 * * *
BASE_URL=http://localhost:3000

# Bank provider: mock (default), plaid or gmail. Tests always use mock data.
BANK_PROVIDER=mock
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_ACCESS_TOKEN=

# Gmail receipt scanning: parsed into transactions like a bank provider.
# Without GMAIL_ACCESS_TOKEN, deterministic demo receipts are used.
GMAIL_ACCESS_TOKEN=

# Receipt OCR: mock (default, uses pasted text) or tesseract (tesseract.js,
# downloads language data on first use).
OCR_PROVIDER=mock
OCR_LANGUAGES=eng
OCR_MOCK_TEXT=